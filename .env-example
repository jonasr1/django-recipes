# Default number of objects per page
PER_PAGE = 9

# Django secret key
SECRET_KEY = "CHANGE-ME"

# Debug mode
DEBUG = False

# Selenium configuration
SELENIUM_HEADLESS = "--headless"

# =====================
# Database configuration
# =====================

# SQLite
DATABASE_ENGINE = "django.db.backends.sqlite3"
DATABASE_NAME = "./db.sqlite3"

# PostgreSQL (uncomment to use)
# DATABASE_ENGINE = "django.db.backends.postgresql"
# DATABASE_NAME = "database_name"

DATABASE_USER = "user"
DATABASE_PASSWORD = "password"
DATABASE_HOST = "127.0.0.1"
DATABASE_PORT = "5432"

# =====================
# Cloudflare R2 (S3-compatible storage)
# =====================

AWS_ACCESS_KEY_ID = your-access-key-id  # Cloudflare R2 Access Key ID
AWS_SECRET_ACCESS_KEY = your-secret-access-key  # Cloudflare R2 Secret Access Key
AWS_STORAGE_BUCKET_NAME = your-bucket-name  # Cloudflare R2 bucket name
AWS_S3_REGION_NAME = auto  # Use auto for Cloudflare R2
AWS_S3_ENDPOINT_URL = https://<account_id>.r2.cloudflarestorage.com  # R2 endpoint URL

# Default file storage backend
DEFAULT_FILE_STORAGE = "storages.backends.s3boto3.S3Boto3Storage"

# Public R2 custom domain
AWS_S3_CUSTOM_DOMAIN = "pub-your-key.r2.dev"
